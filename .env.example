# VENUE0 environment
# Setup: cp .env.example .env, then fill values in .env only.
# .env is gitignored. Never commit it and never paste keys into chat.
# Leaving a value empty is fine. Each section says what breaks without it.

# ============================================================================
# 1. PROOF WALLETS (needed now for live G0-G4)
# ============================================================================
# Three brand-new hot wallets that hold only proof funds. Never use a personal wallet.
# Easiest option: leave these empty and run `pnpm wallets:generate`. It appends fresh
# keys to .env and prints only the addresses you need to fund.
# Format: 0x followed by 64 hex characters.
#
# Wallet A: fund with ~0.003 ETH + ~$30 NVDA
#   NVDA Stock Token: 0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
VENUE0_WALLET_A_PRIVATE_KEY=
# Wallet B: fund with ~0.003 ETH + ~$30 AAPL
#   AAPL Stock Token: 0xaF3D76f1834A1d425780943C99Ea8A608f8a93f9
VENUE0_WALLET_B_PRIVATE_KEY=
# Wallet C: fund with ~0.003 ETH + ~$30 SPY
#   SPY Stock Token: 0x117cc2133c37B721F49dE2A7a74833232B3B4C0C
VENUE0_WALLET_C_PRIVATE_KEY=
#
# All funds go on Robinhood Chain mainnet (chain id 4663).
# Bridge ETH: https://docs.robinhood.com/chain/bridging/
# Buy Stock Tokens: https://docs.robinhood.com/chain/building-with-stock-tokens/
# Only send to the exact addresses above. Same-ticker tokens elsewhere are not Stock Tokens.

# Optional. A separate wallet that deploys the contract and submits settlements.
# Leave empty and wallet A does both.
VENUE0_DEPLOYER_PRIVATE_KEY=

# Leave empty on the first live run. After the first run deploys Venue0Settlement,
# copy "settlementContract" from evidence/live/L2-cycle/<run>/summary.json here
# so later rounds reuse that contract.
CROSSING_SETTLEMENT_ADDRESS=

# ============================================================================
# 2. RPC (recommended now; the public RPC is used when empty)
# ============================================================================
# Executor RPC. Get a free key at https://www.alchemy.com/ and enable Robinhood Chain Mainnet.
# Format: https://robinhood-mainnet.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
# Without it: the public RPC works, but it is rate-limited.
ROBINHOOD_RPC_URL=

# Verifier RPC. Use a DIFFERENT provider from above (QuickNode, Chainstack, dRPC)
# with historical state, so verification is independent of the executor.
# Providers: https://docs.robinhood.com/chain/connecting/
#   QuickNode format:  https://<name>.robinhood-mainnet.quiknode.pro/<token>
#   Chainstack format: https://robinhood-mainnet.core.chainstack.com/<endpoint>
# Without it: the verifier shares the executor RPC and must run within minutes,
# because the public RPC drops state older than ~10,000 blocks.
VERIFIER_RPC_URL=

# ============================================================================
# 3. UNISWAP (Phase 9: residual execution)
# ============================================================================
# Get it at https://developers.uniswap.org/dashboard/welcome. Free.
# Sent as the x-api-key header, server-side only.
UNISWAP_API_KEY=

# ============================================================================
# 4. DEFINITIVE FLASH (Phase 11: Limit/TWAP residual orders)
# ============================================================================
# Get it at app.definitive.fi: sign up, then More -> Flash -> Create Flash Key.
# It is a single key with no secret, and there is no sandbox.
FLASH_API_KEY=

# ============================================================================
# 5. DYNAMIC (Phase 10: agent wallet). Use the SANDBOX environment.
# ============================================================================
# Dashboard -> Developer -> SDK and API Keys (Sandbox toggle on).
# In the dashboard, turn on Embedded Wallets and "multiple embedded wallets per chain".
DYNAMIC_ENVIRONMENT_ID=
# Created on the same page. Secret: together with key shares it can sign.
DYNAMIC_API_TOKEN=
# Password that encrypts wallet key-share backups. Make one up (long and random),
# e.g. `openssl rand -hex 32`. If you lose it, the backups can't be decrypted.
DYNAMIC_WALLET_PASSWORD=
# Delegated access only. Leave empty until the frontend and webhook exist.
DYNAMIC_WEBHOOK_SECRET=
DYNAMIC_DELEGATION_PRIVATE_KEY_PEM=

# ============================================================================
# 7. PRODUCTION WEB APP (Cloudflare Workers + Supabase Postgres)
# ============================================================================
# Supabase project -> Connect -> "Session pooler" connection string (port 5432).
# Use the session pooler: it is IPv4 (reachable from your machine and from Cloudflare Hyperdrive) and supports
# prepared statements. Do NOT use the transaction pooler (port 6543): it breaks prepared statements.
# The direct string (db.<ref>.supabase.co) is IPv6-only unless you buy the IPv4 add-on.
# Format: postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres
#   <PROJECT_REF>: Project Settings -> General -> Project ID (20 lowercase letters)
#   <DB_PASSWORD>: the database password you set when creating the project (Database -> Settings to reset)
#   If the password contains @ : / ? # % characters, URL-encode them.
# Used by `pnpm db:migrate` locally and, via a Hyperdrive config, by the deployed Worker.
# Without it: the local server falls back to an embedded database in apps/web/.venue0-db (single host only).
DATABASE_URL=

# Signs Venue0's own session cookie (HS256). Required in production. Generate with: openssl rand -hex 32
# Changing it signs everyone out. Set it as a Worker secret; locally it is optional.
SESSION_SECRET=

# Only if you want the language agent's "Describe it" mode. Without it, users set weights directly.
ANTHROPIC_API_KEY=
# Preferred over Anthropic when set. Free tier at https://console.groq.com/keys. Model: openai/gpt-oss-120b (strict JSON schema).
GROQ_API_KEY=
