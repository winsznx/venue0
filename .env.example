# Copy to .env (gitignored). Never commit real values.

# --- Required for live G0-G4 proofs ---------------------------------------
# Dedicated hot wallets holding only proof funds. `pnpm wallets:generate` creates them locally.
VENUE0_WALLET_A_PRIVATE_KEY=
VENUE0_WALLET_B_PRIVATE_KEY=
VENUE0_WALLET_C_PRIVATE_KEY=
# Optional separate deployer/submitter; wallet A is used when empty.
VENUE0_DEPLOYER_PRIVATE_KEY=
# Reuse an already deployed Venue0Settlement instead of deploying a new one.
CROSSING_SETTLEMENT_ADDRESS=

# --- RPC (public endpoint used when empty) ---------------------------------
# Executor RPC. Recommended: Alchemy https://robinhood-mainnet.g.alchemy.com/v2/<key>
ROBINHOOD_RPC_URL=
# Independent verifier RPC. Should be a different provider from ROBINHOOD_RPC_URL, with archive state.
VERIFIER_RPC_URL=

# --- Later phases ----------------------------------------------------------
UNISWAP_API_KEY=
FLASH_API_KEY=
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_TOKEN=
DYNAMIC_WALLET_PASSWORD=
DYNAMIC_WEBHOOK_SECRET=
DYNAMIC_DELEGATION_PRIVATE_KEY_PEM=
