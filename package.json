{
  "name": "venue0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:matcher": "vitest run packages/matcher packages/reference-matcher",
    "test:contracts": "forge test --root contracts",
    "research:assets": "tsx scripts/research-assets.ts",
    "contracts:build": "forge build --root contracts && tsx scripts/export-abi.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.5",
    "eslint": "10.10.0",
    "fast-check": "4.10.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
