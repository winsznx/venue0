{
  "name": "venue0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:matcher": "vitest run packages/matcher packages/reference-matcher",
    "test:contracts": "forge test --root contracts",
    "research:assets": "tsx scripts/research-assets.ts",
    "contracts:build": "forge build --root contracts && tsx scripts/export-abi.ts",
    "wallets:generate": "tsx --env-file-if-exists=.env scripts/generate-wallets.ts",
    "proof:l0": "tsx --env-file-if-exists=.env scripts/live/l0-transfer.ts",
    "proof:round": "tsx --env-file-if-exists=.env scripts/live/round.ts",
    "rehearse": "tsx scripts/live/l0-transfer.ts --fork NVDA 0.01 && tsx scripts/live/round.ts --fork L1 25 && tsx scripts/live/round.ts --fork L2 25 && tsx scripts/live/round.ts --fork L3 25 && tsx scripts/live/round.ts --fork L4 25",
    "wallets:status": "tsx --env-file-if-exists=.env scripts/wallet-status.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/live/reverify.ts",
    "proof:residual": "tsx --env-file-if-exists=.env scripts/live/l5-residual.ts",
    "proof:flash": "tsx --env-file-if-exists=.env scripts/live/l6-flash.ts",
    "campaign": "tsx campaign/runner/run.ts --frozen",
    "campaign:smoke": "tsx campaign/runner/run.ts --smoke",
    "campaign:analyze": "tsx campaign/runner/analyze.ts",
    "agent:examples": "tsx --env-file-if-exists=.env scripts/agent/interpret-examples.ts",
    "web:data": "tsx scripts/web/build-view-data.ts",
    "web:dev": "pnpm --filter @venue0/web dev",
    "web:build": "pnpm web:data && pnpm --filter @venue0/web build",
    "web:start": "pnpm --filter @venue0/web start",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/db/migrate.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.5",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
